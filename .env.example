# Öffentliche App-URL (für Magic-Link-Redirect etc.). In Vercel: https://sales-app-fawn.vercel.app
NEXT_PUBLIC_APP_URL=https://sales-app-fawn.vercel.app

# Supabase – aus dem Dashboard unter Project Settings → API kopieren
NEXT_PUBLIC_SUPABASE_URL=https://oxxzczmibzyusonwzdvc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im94eHpjem1pYnp5dXNvbnd6ZHZjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzA5OTYxMDQsImV4cCI6MjA4NjU3MjEwNH0.y7Sv3gFsgiKXpcE3uEsClAIyq_1misbyw-RmENeUSpg

# Service Role (nur Server, niemals im Client): Project Settings → API → service_role
# Erforderlich u. a. für: Registrierung/generateLink, „Signale abrufen“, Vercel-Cron-Ingest (Org-weit; RLS der Watchlist ist pro User).
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron: Authorization Bearer CRON_SECRET. Hobby: Crons nur 1×/Tag (siehe vercel.json).
CRON_SECRET=
# Vercel Hobby: Digest einmal täglich zum Cron-Zeitpunkt (UTC), ohne lokales 10-Min-Fenster – in Vercel setzen:
MARKET_SIGNALS_DIGEST_SKIP_TIME_WINDOW=1
# Optional: geplanten Markt-Signale-Digest per Cron überspringen
# MARKET_SIGNALS_DIGEST_CRON_DISABLED=1
# Pro: Cron */10 für Digest + MARKET_SIGNALS_DIGEST_SKIP_TIME_WINDOW weglassen oder =0 für lokale Uhrzeit im Profil
# Optional: Sofort-Mail/Push nach Ingest (company-news + manueller Abruf) abschalten
# MARKET_SIGNALS_INSTANT_ALERTS_DISABLED=1

# Web Push (VAPID): npx web-push generate-vapid-keys — Public Key auch fürs Frontend
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional, Standard mailto:hello@refstack.io
# VAPID_SUBJECT=mailto:team@deine-domain.de

# Resend (E-Mails: Freigaben, Referenzbedarf, Team-Einladungen, Markt-Signale-Digest, optional Bestätigungslink bei Registrierung)
RESEND_API_KEY=re_hUHJTUkM_GF9ZcUWRe73V1kQC142PahYH
# Optional: Absender mit verifizierter Domain, z. B. "Refstack <team@deine-domain.de>".
# Ohne RESEND_FROM nutzt die App onboarding@resend.dev (nur für Tests / eingeschränkte Empfänger).
RESEND_FROM=onboarding@resend.dev

# E-Mail für "Referenzbedarf melden" (wird an diesen Reference Manager gesendet)
REFERENCE_MANAGER_EMAIL=

# Support-Sidebar: WhatsApp wa.me (nur Ziffern, Ländervorwahl ohne +), z. B. 4915112345678
NEXT_PUBLIC_SUPPORT_WHATSAPP_E164=
# Öffentliche Support-Adresse für mailto: im Dialog (Anzeige + Link)
NEXT_PUBLIC_SUPPORT_EMAIL=support@refstack.ai
# Empfänger der Resend-Benachrichtigung bei Ticket/Feedback aus dem Modal (Server)
SUPPORT_INBOX_EMAIL=support@refstack.ai

# Brandfetch API (Unternehmensdaten: Logo, Website, Branche, HQ, Mitarbeiter)
# Key unter https://brandfetch.com/ anlegen
BRANDFETCH_API_KEY=
# Optional: Client-ID für die Brand-Search API (Autocomplete nach Namen). https://developers.brandfetch.com
# Ohne Client-ID wird bei der Suche ein Domain-Fallback genutzt (weniger Treffer).
BRANDFETCH_CLIENT_ID=

# Rollen-Vorschau (Profilmenü + Einstellungen): immer verfügbar; Rolle wird per HttpOnly-Cookie gespeichert.

# OpenAI API (Magic Import: Referenzdaten aus PDF/PPTX extrahieren)
OPENAI_API_KEY=
