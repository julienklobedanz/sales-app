{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "middleware.ts",
    "scripts/**/*.{ts,mjs,js}",
    "public/sw.js",
    "supabase/functions/**/*.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts",
    "tests/integration/vitest.setup.ts"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "hooks/**/*.{ts,tsx}",
    "scripts/**/*.{ts,mjs,js}",
    "public/sw.js",
    "supabase/functions/**/*.ts"
  ],
  "ignore": ["lib/database.types.ts", "lib/supabase.ts"],
  "ignoreDependencies": [
    "server-only",
    "shadcn",
    "tailwindcss",
    "tw-animate-css",
    "@radix-ui/react-checkbox",
    "@radix-ui/react-collapsible",
    "pdfjs-dist"
  ],
  "ignoreBinaries": ["supabase"],
  "ignoreIssues": {
    "lib/**/*.{ts,tsx}": ["exports", "types", "nsExports", "nsTypes"],
    "components/**/*.{ts,tsx}": ["exports", "types", "nsExports", "nsTypes"],
    "hooks/**/*.{ts,tsx}": ["exports", "types", "nsExports", "nsTypes"],
    "app/**/actions.ts": ["exports", "types"],
    "app/**/*-actions.ts": ["exports", "types"],
    "app/**/*-impl.ts": ["exports", "types"]
  }
}
