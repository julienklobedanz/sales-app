{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "app/**/{page,layout,route,loading,error,template,default,global-error,not-found}.{ts,tsx}",
    "scripts/check-raw-palette-classes.mjs",
    "scripts/check-enclosure-classes.mjs",
    "scripts/check-dark-variants.mjs",
    "scripts/check-copy-keys.mjs",
    "scripts/verify-launch-env.mjs",
    "scripts/seed-*.{ts,mjs,js}",
    "scripts/backfill-*.{ts,mjs,js}",
    "scripts/overhaul-legacy-references.ts",
    "public/sw.js",
    "supabase/functions/**/*.ts"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "hooks/**/*.{ts,tsx}",
    "scripts/**/*.{ts,mjs,js}",
    "app/**/*.css",
    "styles/**/*.css",
    "supabase/functions/**/*.ts"
  ],
  "ignore": ["lib/database.types.ts", "lib/supabase.ts"],
  "ignoreDependencies": [
    "server-only",
    "@radix-ui/react-checkbox",
    "@radix-ui/react-collapsible",
    "pdfjs-dist"
  ],
  "ignoreBinaries": ["supabase"],
  "tags": ["-public"],
  "ignoreIssues": {
    "components/ui/**/*.{ts,tsx}": ["exports", "types", "nsExports", "nsTypes"]
  }
}
